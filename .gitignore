# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated VS/Rider/IDE files
.vs/
.idea/
.vscode/
*.csproj
*.sln
*.unityproj
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.suo

# Unity3D generated meta / crash files
sysinfo.txt
*.stackdump
crashlytics-build.properties

# Builds / packages
*.apk
*.aab
*.unitypackage
*.app

# OS files
.DS_Store
Thumbs.db
